{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "arc-study-resource-website-test",
  "main": "../../dist/server/index.js",
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "LOCAL_DEV_AUTH_BYPASS": "true" },
  "assets": { "directory": "../../dist/client", "binding": "ASSETS" },
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "synthetic-resource-originals" }],
  "d1_databases": [{ "binding": "DB", "database_name": "synthetic-resource-website", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../drizzle" }]
}
