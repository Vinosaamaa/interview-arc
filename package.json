{
  "name": "interview-arc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:import:local": "node scripts/import-content.mjs",
    "content:import:remote": "node scripts/import-content.mjs --remote",
    "dev": "pnpm dev:prepare && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:prepare": "WRANGLER_LOG_PATH=.wrangler/wrangler.log pnpm db:migrate:local && WRANGLER_LOG_PATH=.wrangler/wrangler.log pnpm content:import:local",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "pnpm run build && node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "mcp:config:check": "node scripts/validate-mcp-tool-allowlist.mjs",
    "mcp:config:sync-outer": "node scripts/validate-mcp-tool-allowlist.mjs --sync-outer",
    "behavioral:evidence:validate": "node scripts/build-behavioral-evidence-site.mjs --validate-only",
    "behavioral:evidence:build": "node scripts/build-behavioral-evidence-site.mjs",
    "behavioral:evidence:status": "node scripts/behavioral-evidence-controller.mjs status",
    "behavioral:evidence:authorize-filesystem": "node scripts/behavioral-evidence-controller.mjs authorize-filesystem",
    "behavioral:evidence:refresh": "node scripts/behavioral-evidence-controller.mjs refresh",
    "behavioral:evidence:prepare-sync": "node scripts/behavioral-evidence-controller.mjs prepare-sync",
    "resume:import:google-doc": "node scripts/import-google-doc-resume.mjs",
    "cover-letter:publish": "node scripts/publish-cover-letter-to-job-journey.mjs",
    "code-attempt-review:backfill": "node --experimental-strip-types scripts/backfill-code-attempt-review.mjs",
    "leetcode:browser": "node scripts/leetcode-playwright-controller.mjs",
    "journal:checkpoint": "node scripts/journal-branch.mjs checkpoint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.4",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "playwright-core": "1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
