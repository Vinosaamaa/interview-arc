{
  "manifest_version": 3,
  "name": "Interview Arc Companion",
  "version": "1.1.6",
  "description": "Keep Interview Arc time, notes, outcome, and journal status beside LeetCode.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://leetcode.com/problems/*",
    "https://www.leetcode.com/problems/*",
    "https://limitless.vinosama.workers.dev/*",
    "https://limitless-mcp.vinosama.workers.dev/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/brand-16.png",
    "32": "icons/brand-32.png",
    "48": "icons/brand-48.png",
    "128": "icons/brand-128.png"
  },
  "action": {
    "default_title": "Open Interview Arc",
    "default_icon": {
      "16": "icons/brand-16.png",
      "32": "icons/brand-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
