{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interview-arc:chatgpt-practice-exchange:1",
  "title": "ChatGPT practice exchange v1",
  "oneOf": [{"$ref":"#/$defs/bank"},{"$ref":"#/$defs/export"}],
  "$defs": {
    "key": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[a-z0-9][a-z0-9._:-]*$"},
    "strings": {"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "keys": {"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/key"},"uniqueItems":true},
    "timestamp": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "specialty": {"enum":["leetcode","system_design","behavioral"]},
    "outcome": {"enum":["solved","solved_after_reviewing_approach","failed",null]},
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptCount","lastOutcome","lastCompletedAt","reviewDueDate"],
      "properties": {
        "attemptCount": {"type":["integer","null"],"minimum":0},
        "lastOutcome": {"$ref":"#/$defs/outcome"},
        "lastCompletedAt": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "reviewDueDate": {"type":["string","null"],"format":"date"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialty","questionId","title","url","prompt","topics","availability","progress"],
      "properties": {
        "specialty": {"$ref":"#/$defs/specialty"},
        "questionId": {"type":["string","null"],"minLength":1,"maxLength":160,"pattern":"^[a-z0-9][a-z0-9._:-]*$"},
        "title": {"type":"string","minLength":1,"maxLength":2000},
        "url": {"type":["string","null"],"format":"uri"},
        "prompt": {"type":["string","null"],"minLength":1,"maxLength":20000},
        "topics": {"$ref":"#/$defs/strings"},
        "availability": {"enum":["active","inactive","unknown"]},
        "progress": {"oneOf":[{"$ref":"#/$defs/progress"},{"type":"null"}]}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId","sourceDescription","sourceRevision","dataAsOf"],
      "properties": {
        "snapshotId": {"$ref":"#/$defs/key"},
        "sourceDescription": {"type":"string","minLength":1,"maxLength":2000},
        "sourceRevision": {"type":["string","null"],"minLength":1,"maxLength":2000},
        "dataAsOf": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"}
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion","kind","snapshot","timeZone","visibility","scope","questions"],
      "properties": {
        "schemaVersion": {"const":1},
        "kind": {"const":"bank_snapshot"},
        "snapshot": {"$ref":"#/$defs/snapshot"},
        "timeZone": {"const":"America/Los_Angeles"},
        "visibility": {"enum":["public_catalog","owner_private"]},
        "scope": {"enum":["selected","all"]},
        "questions": {"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/question"},"minItems":1}
      },
      "allOf": [
        {"if":{"properties":{"visibility":{"const":"public_catalog"}}},"then":{"properties":{"questions":{"items":{"properties":{"progress":{"type":"null"}}}}}}}
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command","at","timestampBasis","evidence"],
      "properties": {
        "command": {"enum":["start","pause","resume","finish"]},
        "at": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "timestampBasis": {"enum":["exposed_clock","platform_export","user_reported",null]},
        "evidence": {"type":["string","null"],"minLength":1,"maxLength":2000}
      },
      "allOf": [
        {"if":{"properties":{"at":{"type":"null"}}},"then":{"properties":{"timestampBasis":{"type":"null"}}},"else":{"properties":{"timestampBasis":{"enum":["exposed_clock","platform_export","user_reported"]},"evidence":{"type":"string","minLength":1,"maxLength":2000}}}}
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state","activeMinutes","basis","evidence","events"],
      "properties": {
        "state": {"enum":["running","paused","finished"]},
        "activeMinutes": {"type":["number","null"],"minimum":0,"maximum":10080},
        "basis": {"enum":["observed_boundaries","user_estimate","unknown"]},
        "evidence": {"type":["string","null"],"minLength":1,"maxLength":2000},
        "events": {"type":"array","maxItems":1000,"items":{"$ref":"#/$defs/event"}}
      },
      "allOf": [
        {"if":{"properties":{"basis":{"const":"unknown"}}},"then":{"properties":{"activeMinutes":{"type":"null"}}}},
        {"if":{"properties":{"basis":{"const":"user_estimate"}}},"then":{"properties":{"activeMinutes":{"type":"number"},"evidence":{"type":"string","minLength":1,"maxLength":2000}}}},
        {"if":{"properties":{"basis":{"const":"observed_boundaries"}}},"then":{"properties":{"activeMinutes":{"type":"number"},"evidence":{"type":"string","minLength":1,"maxLength":2000},"events":{"minItems":2,"items":{"properties":{"at":{"type":"string"}}}}}}}
      ]
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnKey","sequence","speaker","text","occurredAt","timestampBasis"],
      "properties": {
        "turnKey": {"$ref":"#/$defs/key"},
        "sequence": {"type":"integer","minimum":1},
        "speaker": {"enum":["user","assistant"]},
        "text": {"type":"string","minLength":1,"maxLength":100000},
        "occurredAt": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "timestampBasis": {"enum":["platform_export","user_reported",null]}
      },
      "allOf": [
        {"if":{"properties":{"occurredAt":{"type":"null"}}},"then":{"properties":{"timestampBasis":{"type":"null"}}},"else":{"properties":{"timestampBasis":{"enum":["platform_export","user_reported"]}}}}
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceChatKey","kind","providedRange","coverage","gaps","turns"],
      "properties": {
        "sourceChatKey": {"$ref":"#/$defs/key"},
        "kind": {"enum":["text_chat","voice_transcript","mixed_chat","account_export","pasted_text","summary_only"]},
        "providedRange": {"type":"string","minLength":1,"maxLength":2000},
        "coverage": {"enum":["complete_provided_source","partial","summary_only"]},
        "gaps": {"$ref":"#/$defs/strings"},
        "turns": {"type":"array","maxItems":10000,"items":{"$ref":"#/$defs/turn"}}
      },
      "allOf": [
        {"if":{"properties":{"coverage":{"const":"summary_only"}}},"then":{"properties":{"kind":{"const":"summary_only"},"turns":{"maxItems":0},"gaps":{"minItems":1}}}},
        {"if":{"properties":{"kind":{"const":"summary_only"}}},"then":{"properties":{"coverage":{"const":"summary_only"}}}},
        {"if":{"properties":{"coverage":{"const":"partial"}}},"then":{"properties":{"gaps":{"minItems":1}}}},
        {"if":{"properties":{"coverage":{"const":"complete_provided_source"}}},"then":{"properties":{"turns":{"minItems":1}}}}
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptKey",
        "snapshotId",
        "question",
        "practiceDate",
        "dateBasis",
        "mode",
        "kind",
        "userAttempted",
        "outcome",
        "outcomeEvidenceTurnKeys",
        "sourceChatKeys",
        "turnKeys",
        "timing",
        "summary",
        "review",
        "gaps"
      ],
      "properties": {
        "attemptKey": {"$ref":"#/$defs/key"},
        "snapshotId": {"type":["string","null"],"minLength":1,"maxLength":160,"pattern":"^[a-z0-9][a-z0-9._:-]*$"},
        "question": {"type":"object","additionalProperties":false,"required":["specialty","questionId","title","url","prompt"],"properties":{"specialty":{"$ref":"#/$defs/specialty"},"questionId":{"type":["string","null"],"minLength":1,"maxLength":160,"pattern":"^[a-z0-9][a-z0-9._:-]*$"},"title":{"type":"string","minLength":1,"maxLength":2000},"url":{"type":["string","null"],"format":"uri"},"prompt":{"type":["string","null"],"minLength":1,"maxLength":20000}}},
        "practiceDate": {"type":["string","null"],"format":"date"},
        "dateBasis": {"enum":["user_reported","source_timestamp",null]},
        "mode": {"enum":["interviewer","mentor"]},
        "kind": {"enum":["attempt","walkthrough","discussion"]},
        "userAttempted": {"type":["boolean","null"]},
        "outcome": {"$ref":"#/$defs/outcome"},
        "outcomeEvidenceTurnKeys": {"$ref":"#/$defs/keys"},
        "sourceChatKeys": {"$ref":"#/$defs/keys","minItems":1},
        "turnKeys": {"$ref":"#/$defs/keys"},
        "timing": {"$ref":"#/$defs/timing"},
        "summary": {"type":"string","maxLength":20000},
        "review": {"type":"string","maxLength":20000},
        "gaps": {"$ref":"#/$defs/strings"}
      },
      "allOf": [
        {"if":{"properties":{"practiceDate":{"type":"null"}}},"then":{"properties":{"dateBasis":{"type":"null"}}},"else":{"properties":{"dateBasis":{"enum":["user_reported","source_timestamp"]}}}},
        {"if":{"properties":{"outcome":{"type":"string"}}},"then":{"properties":{"userAttempted":{"const":true},"kind":{"const":"attempt"},"question":{"properties":{"specialty":{"const":"leetcode"}}},"outcomeEvidenceTurnKeys":{"minItems":1}}}},
        {"if":{"properties":{"kind":{"const":"walkthrough"}}},"then":{"properties":{"outcome":{"type":"null"}}}},
        {"if":{"properties":{"kind":{"const":"discussion"}}},"then":{"properties":{"outcome":{"type":"null"}}}}
      ]
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionKey","timing","attempts"],
      "properties": {
        "sessionKey": {"$ref":"#/$defs/key"},
        "timing": {"$ref":"#/$defs/timing"},
        "attempts": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/attempt"},"minItems":1}
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion","kind","packetId","exportedAt","timeZone","snapshots","sources","sessions","gaps"],
      "properties": {
        "schemaVersion": {"const":1},
        "kind": {"const":"practice_export"},
        "packetId": {"$ref":"#/$defs/key"},
        "exportedAt": {"type":["string","null"],"format":"date-time","pattern":"(Z|[+-][0-9]{2}:[0-9]{2})$"},
        "timeZone": {"const":"America/Los_Angeles"},
        "snapshots": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/snapshot"}},
        "sources": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/source"},"minItems":1},
        "sessions": {"type":"array","maxItems":100,"items":{"$ref":"#/$defs/session"},"minItems":1},
        "gaps": {"$ref":"#/$defs/strings"}
      }
    }
  }
}
