{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-arc.local/schemas/question-bank.schema.json",
  "title": "Interview Arc LeetCode Question Bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url", "difficulty", "topics", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "problemNumber": { "type": "integer", "minimum": 1 },
          "url": {
            "type": "string",
            "pattern": "^https://leetcode\\.com/problems/[a-z0-9-]+/?$"
          },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "topics": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "companyTags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "acceptanceRate": { "type": "number", "minimum": 0, "maximum": 100 },
          "companySignals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["company", "window", "frequencyScore", "frequencyScale", "capturedAt"],
              "properties": {
                "company": { "type": "string", "minLength": 1 },
                "window": { "type": "string", "minLength": 1 },
                "frequencyScore": { "type": "integer", "minimum": 0 },
                "frequencyScale": { "type": "integer", "minimum": 1 },
                "capturedAt": { "type": "string", "format": "date" }
              }
            }
          },
          "frequencyWindow": { "type": "string" },
          "targetMinutes": { "type": "integer", "minimum": 5 },
          "source": { "enum": ["manual", "user_import"] },
          "active": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
