{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interview-arc.local/schemas/behavioral-evidence-manifest.schema.json",
  "title": "Behavioral Evidence Bundle Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "title",
    "visibility",
    "createdAt",
    "updatedAt",
    "projects"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "$ref": "#/$defs/stableId" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "visibility": { "const": "local_only" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "recordPath"],
        "properties": {
          "id": { "$ref": "#/$defs/stableId" },
          "recordPath": { "$ref": "#/$defs/relativePath" }
        }
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
