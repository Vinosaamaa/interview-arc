{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vinosaamaa/interview-arc/blob/main/docs/contracts/practice-record.schema.json",
  "title": "Immutable owner-private Practice Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "activityId", "revision", "questionId", "specialty",
    "completedAt", "practiceDate", "practiceTimezone", "timing", "outcome",
    "interactionMode", "prompt", "summary", "transcript", "notesRevision",
    "specialtyOutput", "review", "references", "solutionLink", "assetLinks",
    "finalizationOperationId", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "activityId": { "$ref": "#/$defs/stableId" },
    "revision": { "type": "integer", "minimum": 1 },
    "questionId": { "$ref": "#/$defs/stableId" },
    "specialty": { "enum": ["leetcode", "behavioral", "system_design"] },
    "completedAt": { "$ref": "#/$defs/dateTime" },
    "practiceDate": { "type": "string", "format": "date" },
    "practiceTimezone": { "const": "America/Los_Angeles" },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "startedAt", "endedAt", "elapsedSeconds", "sessionId"],
      "properties": {
        "source": { "enum": ["website", "manual", "unknown"] },
        "startedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "endedAt": { "oneOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
        "elapsedSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "sessionId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] }
      }
    },
    "outcome": { "enum": ["solved", "solved_after_reviewing_approach", "failed", null] },
    "interactionMode": { "enum": ["interviewer", "mentor", "grill", "mixed", "unknown"] },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "canonicalUrl"],
      "properties": {
        "title": { "$ref": "#/$defs/nonempty" },
        "body": { "$ref": "#/$defs/nonempty" },
        "canonicalUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "summary": { "$ref": "#/$defs/nonempty" },
    "transcript": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "turnCount", "firstTurnId", "lastTurnId"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "turnCount": { "type": "integer", "minimum": 0 },
        "firstTurnId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] },
        "lastTurnId": { "oneOf": [{ "$ref": "#/$defs/stableId" }, { "type": "null" }] }
      }
    },
    "notesRevision": { "type": ["integer", "null"], "minimum": 1 },
    "specialtyOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "responseStages", "codeAttemptIds", "finalAnswerRevision", "designAssetIds"],
      "properties": {
        "kind": { "enum": ["code_attempts", "final_tailored_answer", "your_design"] },
        "responseStages": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "state", "ownerResponse", "mentorGuidance", "finalUnderstanding", "turnIds"],
            "properties": {
              "key": { "$ref": "#/$defs/stableId" },
              "state": { "enum": ["answered", "partially_answered", "no_answer_provided", "needs_correction"] },
              "ownerResponse": { "type": ["string", "null"] },
              "mentorGuidance": { "type": ["string", "null"] },
              "finalUnderstanding": { "type": ["string", "null"] },
              "turnIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
            }
          }
        },
        "codeAttemptIds": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true },
        "finalAnswerRevision": { "type": ["integer", "null"], "minimum": 1 },
        "designAssetIds": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/stableId" }, "uniqueItems": true }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["didWell", "improve", "nextDrill"],
      "properties": {
        "didWell": { "$ref": "#/$defs/stringList" },
        "improve": { "$ref": "#/$defs/stringList" },
        "nextDrill": { "type": ["string", "null"] }
      }
    },
    "references": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "accessedAt"],
        "properties": {
          "title": { "$ref": "#/$defs/nonempty" },
          "url": { "type": "string", "format": "uri" },
          "accessedAt": { "$ref": "#/$defs/dateTime" }
        }
      }
    },
    "solutionLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionId", "profileRevision"],
      "properties": {
        "questionId": { "$ref": "#/$defs/stableId" },
        "profileRevision": { "type": "integer", "minimum": 1 }
      }
    },
    "assetLinks": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "revision", "role"],
        "properties": {
          "assetId": { "$ref": "#/$defs/stableId" },
          "revision": { "type": "integer", "minimum": 1 },
          "role": { "$ref": "practice-asset.schema.json#/$defs/role" }
        }
      }
    },
    "finalizationOperationId": { "$ref": "#/$defs/stableId" },
    "createdAt": { "$ref": "#/$defs/dateTime" }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "dateTime": { "type": "string", "format": "date-time" },
    "nonempty": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "stringList": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/nonempty" } }
  }
}
