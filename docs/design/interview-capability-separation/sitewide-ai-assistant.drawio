  <diagram name="Site-wide AI assistant">
    <mxGraphModel dx="1600" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Ask Interview Arc — site-wide assistant architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=28;fontStyle=1;fontColor=#2F2440;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1040" height="42" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="The assistant selects context and proposes actions across workspaces. Every domain keeps its own read authority, command invariants, and private state." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=14;fontColor=#685C78;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="1420" height="38" as="geometry"/></mxCell>

        <mxCell id="shellTier" value="1  SHARED WEBSITE SHELL" style="swimlane;startSize=34;horizontal=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F0FA;strokeColor=#9A82BB;fontColor=#3F2764;fontStyle=1;fontFamily=Helvetica;fontSize=13;container=1;pointerEvents=0;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1520" height="190" as="geometry"/></mxCell>
        <mxCell id="composer" value="Ask Interview Arc&#xa;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;available from every workspace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5A3D83;strokeColor=#5A3D83;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="shellTier"><mxGeometry x="50" y="65" width="300" height="86" as="geometry"/></mxCell>
